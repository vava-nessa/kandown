{
  "$schema": "https://kandown.dev/schemas/theme.v1.json",
  "id": "linear",
  "name": "Linear",
  "author": "Linear Team",
  "description": "Dark-first aesthetic, Plus Jakarta Sans font, electric violet accent (#5E6AD2), sleek elevated popovers.",
