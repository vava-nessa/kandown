{
  "ui": {
    "language": "en",
    "theme": "light",
    "skin": "kandown",
    "font": "system",
    "background": "solid"
  },
  "agent": {
    "suggestFollowUp": true,
    "maxSuggestions": 2
  },
  "board": {
    "columns": [
      "Backlog",
      "In Progress",
      "Doing 🟢",
      "Review",
      "Todo",
      "Done"
    ],
    "defaultPriority": "P3",
    "defaultOwnerType": "human",
    "columnColors": {
      "in progress": "fuchsia",
      "backlog": "lime",
      "todo": "red",
      "doing 🟢": "slate"
    }
  },
  "fields": {
    "priority": false,
    "assignee": false,
    "tags": false,
    "dueDate": false,
    "ownerType": false,
    "tools": false
  },
  "notifications": {
    "browser": true,
    "sound": true,
    "soundId": "chime",
    "statusChanges": true,
    "taskEdits": true,
    "subtaskCompletions": true,
    "editDebounceMs": 2000
  }
}