{
  "name": "kandown-website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Marketing site and documentation for Kandown.",
  "scripts": {
    "predev": "node scripts/build-search-index.mjs && node scripts/build-llms.mjs && node scripts/build-changelogs.mjs && node scripts/build-sitemap.mjs && node scripts/build-extensions.mjs && node scripts/build-demo.mjs --if-missing",
    "dev": "vite dev --port 4321",
    "prebuild": "node scripts/build-search-index.mjs && node scripts/build-llms.mjs && node scripts/build-changelogs.mjs && node scripts/build-sitemap.mjs && node scripts/build-extensions.mjs && node scripts/build-demo.mjs",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "search-index": "node scripts/build-search-index.mjs",
    "demo": "node scripts/build-demo.mjs",
    "extensions": "node scripts/build-extensions.mjs",
    "llms": "node scripts/build-llms.mjs",
    "changelogs": "node scripts/build-changelogs.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "mathjs": "^15.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@shikijs/rehype": "^3.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "unified": "^11.0.5",
    "vite": "^7.0.0"
  }
}
