node_modules
.output
.nitro
.vercel
.vinxi
.tanstack/
dist

# 📖 Generated by the router plugin and the search-index script on every
# dev/build. Committing them only produces churn.
src/routeTree.gen.ts
src/generated/

# 📖 The interactive demo, rebuilt from the CLI sources by scripts/build-demo.mjs
# on every build. Committing it would let a stale bundle outlive the code it is
# supposed to demonstrate.
public/demo/

*.log
.DS_Store
.env
.env.*
!.env.example
.env*

# 📖 The machine-readable twin of the documentation, generated from the same MDX
# by scripts/build-llms.mjs on every build. Never edit or commit: the MDX is the
# only source of truth.
public/docs/
public/llms.txt
public/llms-full.txt

# 📖 The /changelogs page, generated from the per-release Markdown in
# <repo>/changelogs/ by scripts/build-changelogs.mjs on every build. Source of
# truth lives in the repo root, never here.
public/changelogs/
public/extensions/

# 📖 Both written by scripts/build-sitemap.mjs on every build. robots.txt is
# generated rather than committed because it has to name the sitemap by absolute
# URL, and the domain belongs in src/lib/site.ts only: a committed copy would
# outlive the next domain change and keep pointing crawlers at the old host.
public/sitemap.xml
public/robots.txt
