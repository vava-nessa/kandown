{
  "name": "kandown",
  "version": "0.46.0",
  "description": "File-based Kanban engine backed by Markdown. Zero backend, AI-agent friendly.",
  "type": "module",
  "bin": {
    "kandown": "bin/kandown.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "changelogs",
    "LICENSE"
  ],
  "keywords": [
    "kanban",
    "markdown",
    "task-manager",
    "ai-agents",
    "local-first",
    "file-over-app"
  ],
  "author": {
    "name": "Vanessa Depraute",
    "url": "https://vanessadepraute.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vava-nessa/kandown.git"
  },
  "homepage": "https://kandown.dev",
  "bugs": {
    "url": "https://github.com/vava-nessa/kandown/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/sync-agent-kandown.js && vite",
    "dev:cli": "tsup --watch",
    "dev:app": "pnpm build && node bin/kandown.js",
    "build": "node scripts/inject-version.js && node scripts/sync-agent-kandown.js && tsc -b && vite build && pnpm build:cli",
    "build:cli": "tsup",
    "build:demo": "node scripts/inject-version.js && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:agent": "node scripts/sync-agent-kandown.js",
    "codemap": "node scripts/build-codemap.js",
    "codemap:check": "node scripts/build-codemap.js --check",
    "changelog": "node scripts/build-changelog.js",
    "changelog:check": "node scripts/build-changelog.js --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm codemap:check && pnpm changelog:check && pnpm verify:diff",
    "verify:diff": "git diff --check HEAD -- . ':(exclude).kandown/kandown.html' ':(exclude)bin/kandown.js' ':(exclude)bin/tui.js'",
    "prepare": "node scripts/install-hooks.js"
  },
  "devDependencies": {
    "@tabler/icons-react": "3.41.1",
    "@types/node": "25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "i18next": "26.0.5",
    "ink": "7.0.1",
    "motion": "^12.38.0",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "17.0.4",
    "tailwindcss": "^3.4.17",
    "three": "^0.171.0",
    "tsup": "8.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.9",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "@blocknote/code-block": "0.49.0",
    "@blocknote/core": "0.49.0",
    "@blocknote/mantine": "0.49.0",
    "@blocknote/react": "0.49.0",
    "@radix-ui/react-slot": "1.2.4",
    "chokidar": "^4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jiti": "^2.7.0",
    "lucide-react": "1.8.0",
    "mathjs": "^15.2.0",
    "react-devtools-core": ">=6.1.2",
    "signal-exit": "^3.0.7",
    "tailwind-merge": "3.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
